{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1100px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "background", "color": "#ffffff", "name": "Background" },
        { "slug": "surface", "color": "#f4f5f7", "name": "Surface" },
        { "slug": "foreground", "color": "#14161a", "name": "Foreground" },
        { "slug": "muted", "color": "#5b6472", "name": "Muted" },
        { "slug": "accent", "color": "#cf4647", "name": "Accent" }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        {
          "slug": "x-large",
          "size": "2rem",
          "name": "Extra large",
          "fluid": { "min": "1.5rem", "max": "2.5rem" }
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      }
    }
  }
}
